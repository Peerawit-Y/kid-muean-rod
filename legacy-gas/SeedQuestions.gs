  // เคลียร์ข้อมูลเก่าตั้งแต่แถวที่ 2 ลงไป (คง Header ไว้)
  const lastRow = qSheet.getLastRow();
  if (lastRow > 1) {
    qSheet.getRange(2, 1, lastRow - 1, qSheet.getLastColumn()).clearContent();
  }

  // นำชุดคำถาม 50 ข้อเขียนลง Sheets ด้วย Batch Write ครั้งเดียว
  qSheet.getRange(2, 1, questionPool.length, questionPool[0].length).setValues(questionPool);

  Logger.log("✅ เพิ่มคำถาม 50 ข้อลงชีต Questions สำเร็จเรียบร้อยแล้ว!");
}